# RaSpect Inspectica API — environment configuration
# Copy to .env and adjust.

# HTTP port the API listens on
PORT=4000

# Comma-separated list of allowed browser origins (CORS).
# Add your deployed frontend URL(s) here. "*" allows any origin (dev only).
CORS_ORIGINS=http://localhost:8099,https://dhanada.github.io

# Optional Google Maps / Street View Static API key.
# If set, real street-level building photos are fetched; otherwise the
# product uses free OpenStreetMap map tiles + footprint overlays.
GOOGLE_MAPS_API_KEY=

# Nominatim geocoder: identify your app (required by OSM usage policy).
NOMINATIM_USER_AGENT=RaSpect-Inspectica-Demo/1.0 (contact: hello@raspect.ai)

# Overpass API endpoint (public mirrors; self-host for production volume).
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Open-Meteo API endpoint
OPENMETEO_URL=https://archive-api.open-meteo.com/v1/archive

# SQLite database file path
SQLITE_PATH=./data/raspect.db

# How long to cache external lookups in memory (ms)
CACHE_TTL_MS=3600000
